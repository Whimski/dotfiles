language 0.6
import "../../theme.plm"

// pastel — pastel-bar's floating pill (~/dotfiles/pastel-bar/bar/Bar.qml),
// plain glass look, Mint dark. Hidden at rest; it drops out of the top edge
// while Left Alt is held (`fact expanded`) with the clock, date and battery,
// and as a volume / brightness OSD when those change. It is also the
// notification server: a toast drops in when one arrives, and the three newest
// hang under the pill while it is open.
//
//   pleamar --say pastel "fact expanded true"    // show
//   pleamar --say pastel "fact expanded false"   // hide

scene Pastel {
    surface {
        size: 520, 330
        anchor: top
        margin: 0
        screens: all
        level: top, overlay while shown > 0.01 or toast_in > 0.01
    }
    permissions {
        services: "clock", "audio", "audio.*", "battery", "brightness", "brightness.*", "notifications", "notifications.*", "network", "network.*", "bluetooth", "bluetooth.*", "media", "media.*", "say:settings"
        run: "hyprctl monitors -j", "curl", "magick", "pactl", "pw-dump", "fuser", "ps", "python3 /home/tobi/.config/pleamar/shells/pastel/miclevel.py", "python3 /home/tobi/.config/pleamar/shells/pastel/beat.py"
    }

    service clock as now { time: text = "--:--"; date: text }
    service audio as vol { volume: number; muted: bool }
    service battery as bat { present: bool; percent: number; charging: bool }
    service brightness as lit { present: bool; level: number }
    service network as net { wifi: bool; online: bool; kind: text; name: text }
    service media as song { playing: bool; title: text; artist: text; length: number; can_seek: bool; art: text }


    // ---- state ----
    fact expanded = false                          // held Left Alt (from Hyprland)
    fact osd: none | volume | brightness = none
    fact osd_n = 0                                 // bumped on each key press
    fact ready = false                             // ignore the first reports
    event nudge ->                                 // wheel over the pill → volume

    // ---- what is being shared right now: mic, the computer's sound, screen, camera ----
    model shares max 6 { kind: mic | sound | screen | camera; app: text }
    text share_ignore = ""                 // apps to leave out, "A|B" (from Settings → Privacy)
    image ic_sh_mic = icon "audio-input-microphone-symbolic", 14, 14
    image ic_sh_sound = icon "audio-speakers-symbolic", 14, 14
    image ic_sh_screen = icon "video-display-symbolic", 14, 14
    image ic_sh_cam = icon "camera-web-symbolic", 14, 14

    // ---- notifications (the logic fills these) ----
    model notes max 20 { title: text; body: text; app: text }  // newest first (the pill shows 3)
    fact toast = false                             // the toast is out
    fact toast_n = 0                               // bumped by each new one
    fact toast_hover = false
    text t_title = ""
    text t_body = ""
    event note_open ->                             // a card: its index (-1: the toast)
    event note_close ->
    event clear_notes ->                           // Left Alt + Left Shift
    prop toast_in = 0 ~spring(300, 22)
    prop list_in = 0 ~spring(300, 24)
    follow toast_in = if(toast and not expanded, 1, 0)
    follow list_in = if(expanded and osd == none and notes.count > 0, 1, 0)
    image ic_bell = icon "notifications-symbolic", 13, 13
    image ic_x = icon "window-close-symbolic", 12, 12

    spring pop = 300, 20                           // ≈ OutBack: a little overshoot
    spring drop = 260, 17

    prop shown = 0 ~drop                           // the pill is on screen
    prop bloom = 0 ~520ms                          // expanded content, staggered
    prop osdin = 0 ~quick                          // OSD content
    prop flare = 0 ~420ms                          // accent glow on the edge
    prop kick = 0 ~spring(420, 12)                 // the OSD icon's pop
    prop pw = 120 ~pop
    prop ph = 30 ~pop
    prop meter = 0 ~pop

    follow shown = if(expanded or osd != none, 1, 0)
    follow bloom = if(expanded and osd == none, 1, 0)
    follow osdin = if(osd != none, 1, 0)

    // ---- sizes (pastel-bar: expPad 18, expVPad 6, idlePad 14, fontSize 14) ----
    measure tm
    measure dm
    measure pm
    measure mtm                                   // the song's title, in the pill
    measure mam                                   // and its artist
    measure om
    let has_bat = bat.present and bat.percent > 0
    let low = has_bat and not bat.charging and bat.percent <= 20
    let batw = 16 + 14 + 5 + pm.width
    let sharew = if(shares.count > 0, 12 + shares.count * 28 + (shares.count - 1) * 6, 0)
    let musicw = if(has_media, 32 + 9 + max(mtm.width, mam.width) + 16, 0)   // cover, words, gap
    let toprow = musicw + max(tm.width, dm.width) + sharew + if(has_bat, 12 + batw, 0)
    let expw = 36 + toprow
    let exph = 12 + tm.height + dm.height
    let osdw = 28 + 17 + 10 + 130 + 10 + max(38, om.width)
    let osdh = 12 + 22
    follow pw = if(osd != none, osdw, expw)
    follow ph = if(osd != none, osdh, exph)

    let val = if(osd == brightness, lit.level, if(vol.muted, 0, vol.volume))
    follow meter = 130 * clamp(val, 0, 1)

    // ---- geometry ----
    let cx = 260
    let top = 8
    let cy = top + ph / 2
    let left = cx - pw / 2

    // ---- the pill ----
    group {
        pivot: cx, top
        scale: 0.55 + 0.45 * shown
        opacity: clamp(shown * 1.6, 0, 1)

        shader Theme.glowblob { at: cx - (pw) / 2 - 70, cy - (ph) / 2 - 70; size: pw + 140, ph + 140; values: 70, glow_k; colors: glow_a, glow_b; show: glow_k > 0 }   // midnight's glow

        body {
            color: panel
            glass: 100% * glassy
            lens: false
            tint: 72%
            border: 1 * line, mix(edge, accent, 0.35 * flare)
            shadow: sh_x, 8 * sh_k + sh_hard, 22 * sh_k + sh_min, min(1, 34% * sh_a), sh_color
            box { at: cx, cy; size: pw, ph; corner: (16) * rk }
        }
        shader Theme.aurora { at: cx - (pw) / 2, cy - (ph) / 2; size: pw, ph; corner: (16) * rk; values: aur_k; colors: glow_a, glow_b; show: aur_k > 0 }   // midnight's aurora
        // soft outer glow ring while it flares
        box { at: cx, cy; size: pw + 2, ph + 2; corner: (ph / 2 + 1) * rk; stroke: (2) * line; color: accent; opacity: 18% * flare }

        zone box pill { at: cx, cy; size: pw, ph; corner: (16) * rk; label: "Pastel bar" }

        // ---------- expanded: clock + date, battery ----------
        group {
            opacity: osd == none
            // the music, on the left: cover, title, artist (press: the control center)
            group {
                show: has_media
                opacity: smooth(0.2, 0.9, bloom)
                move: (1 - smooth(0.2, 0.9, bloom)) * -20, 0
                let mx0 = cx - toprow / 2
                let my0 = top + 6 + (tm.height + dm.height) / 2
                zone box pill_music { from: mx0, my0 - 18; size: musicw - 10, 36; corner: 8; cursor: pointer; label: "{m_title}, {m_artist}" }
                body { gradient: mx0, my0 - 16 to mx0 + 32, my0 + 16, art0, art1
                    box { from: mx0, my0 - 16; size: 32, 32; corner: (7) * rk } }
                group {
                    clip box { from: mx0, my0 - 16; size: 32, 32; corner: (7) * rk }
                    image cover { at: mx0, my0 - 16; size: 32, 32; fit: cover }
                }
                // a tiny equalizer on the cover's corner while it plays
                repeat k in 0..3 {
                    box { at: mx0 + 26 + k * 3 - 3, my0 + 12 - (2 + min(6, eq.$k * 0.6)) / 2; size: 2, 2 + min(6, eq.$k * 0.6); corner: 1; color: #ffffff; opacity: if(m_playing, 90%, 0) }
                }
                text m_title { family: Theme.face; at: mx0 + 41, my0 - 7; anchor: left center; size: 12; weight: 600; width: 150; tight: true; lines: 1; color: ink; measure: mtm }
                text m_artist { family: Theme.face; at: mx0 + 41, my0 + 9; anchor: left center; size: 10.5; width: 150; tight: true; lines: 1; color: art0; measure: mam }
                on press pill_music { emit cc_toggle }
            }
            // clock + date drop in first
            group {
                opacity: smooth(0, 0.6, bloom)
                move: 0, (1 - smooth(0, 0.6, bloom)) * -10
                let colx = cx - toprow / 2 + musicw + max(tm.width, dm.width) / 2
                text now.time { family: Theme.face; at: colx, top + 6 + tm.height / 2; anchor: center; size: 20; weight: 700; color: ink; measure: tm }
                text now.date { family: Theme.face; at: colx, top + 6 + tm.height + dm.height / 2; anchor: center; size: 11; color: subink; measure: dm }
            }
            // what is in use: a small ring for each, coloured by kind, right of the time
            row sharerow {
                show: shares.count > 0
                at: cx - toprow / 2 + musicw + max(tm.width, dm.width) + 12, top + 6 + (tm.height + dm.height) / 2
                anchor: left middle
                gap: 6
                opacity: smooth(0.3, 1, bloom)
                for sh in shares {
                    group {
                        size: 28, 28
                        let ring = pick(sh.kind, col_yellow, col_pink, danger, col_green)
                        zone box sh_hit { from: 0, 0; size: 28, 28; corner: 14; label: "{sh.app}" }
                        ellipse { at: 14, 14; radius: 13; color: ring; opacity: 14% }
                        ellipse { at: 14, 14; radius: 13; stroke: 1.5; color: ring }
                        image ic_sh_mic { at: 7, 7; size: 14, 14; tint: ring; show: sh.kind == mic }
                        image ic_sh_sound { at: 7, 7; size: 14, 14; tint: ring; show: sh.kind == sound }
                        image ic_sh_screen { at: 7, 7; size: 14, 14; tint: ring; show: sh.kind == screen }
                        image ic_sh_cam { at: 7, 7; size: 14, 14; tint: ring; show: sh.kind == camera }
                    }
                }
            }
            // battery pill unfurls from the right
            group {
                show: has_bat
                opacity: smooth(0.3, 1, bloom)
                move: (1 - smooth(0.3, 1, bloom)) * 28, 0
                let bx = cx - toprow / 2 + musicw + max(tm.width, dm.width) + sharew + 12
                box { from: bx, cy - 13; size: batw, 26; corner: (13) * rk; color: if(low, danger, hover); opacity: if(low, 18%, 50%) }
                box { from: bx, cy - 13; size: batw, 26; corner: (13) * rk; stroke: (1.4) * line; color: danger; opacity: if(low, 80%, 0) }
                // battery glyph
                box { from: bx + 8, cy - 4.5; size: 12, 9; corner: (2) * rk; stroke: (1.4) * line; color: if(low, danger, subink) }
                box { from: bx + 20.5, cy - 2; size: 1.5, 4; corner: (0.75) * rk; color: if(low, danger, subink) }
                box { from: bx + 9.8, cy - 2.7; size: max(0.5, 8.4 * bat.percent / 100), 5.4; corner: (1) * rk; color: if(low, danger, subink) }
                text "{bat.percent}%" { family: Theme.face; at: bx + 27, cy; anchor: left center; size: 11; weight: 700; color: if(low, danger, ink); measure: pm }
            }
        }

        // ---------- OSD: icon, meter, percent ----------
        group {
            opacity: osdin
            let ix = left + 14 + 8.5
            group {
                pivot: ix, cy
                scale: 1 + 0.3 * kick
                rotate: if(osd == brightness, val * 180deg, 0)
                image ico_vol { at: ix - 8.5, cy - 8.5; size: 17, 17; tint: ink; show: osd == volume and not vol.muted }
                image ico_mute { at: ix - 8.5, cy - 8.5; size: 17, 17; tint: ink; show: osd == volume and vol.muted }
                image ico_sun { at: ix - 8.5, cy - 8.5; size: 17, 17; tint: ink; show: osd == brightness }
            }
            let mx = left + 14 + 17 + 10
            box { from: mx, cy - 3; size: 130, 6; corner: (3) * rk; color: subink; opacity: 30% }
            body {
                gradient: mx, 0 to mx + 130, 0, accent_lo, if(osd == brightness, col_yellow, col_green)
                box { from: mx, cy - 3; size: max(6, meter), 6; corner: (3) * rk }
            }
            // glowing knob riding the fill's edge
            body {
                color: if(osd == brightness, col_yellow, col_green)
                border: 2 * line, knob
                ellipse { at: mx + max(6, meter) - 3, cy; radius: 6 * (1 + 0.3 * kick) }
            }
            text "{round(val * 100)}%" { family: Theme.face; at: mx + 130 + 10, cy; anchor: left center; size: 13; weight: 500; color: ink; measure: om }
        }
    }

    // ---------- the toast: peeks in when a notification arrives ----------
    measure ttm
    measure tbm
    let tw = min(320, 22 + 13 + 8 + max(ttm.width, tbm.width))
    let thh = 12 + 18 + if(tbm.width > 0, 15, 0)
    group {
        show: toast_in > 0.01
        opacity: clamp(toast_in * 1.5, 0, 1)
        move: 0, (1 - toast_in) * -(thh + 6)
        shader Theme.glowblob { at: cx - (tw) / 2 - 70, top + thh / 2 - (thh) / 2 - 70; size: tw + 140, thh + 140; values: 70, glow_k; colors: glow_a, glow_b; show: glow_k > 0 }   // midnight's glow
        body {
            color: panel
            glass: 100% * glassy
            lens: false
            tint: 72%
            border: 1 * line, mix(edge, accent, 0.3)
            shadow: sh_x, 8 * sh_k + sh_hard, 22 * sh_k + sh_min, min(1, 30% * sh_a), sh_color
            box { at: cx, top + thh / 2; size: tw, thh; corner: (thh / 2) * rk }
        }
        shader Theme.aurora { at: cx - (tw) / 2, top + thh / 2 - (thh) / 2; size: tw, thh; corner: (thh / 2) * rk; values: aur_k; colors: glow_a, glow_b; show: aur_k > 0 }   // midnight's aurora
        zone box toast_hit { at: cx, top + thh / 2; size: tw, thh; corner: (thh / 2) * rk; cursor: pointer; label: "Open notification" }
        image ic_bell { at: cx - tw / 2 + 11, top + thh / 2 - 6.5; size: 13, 13; tint: accent }
        let tx = cx - tw / 2 + 32
        text t_title { family: Theme.face; at: tx, top + 6 + 9; anchor: left center; size: 12; weight: 600; width: 270; tight: true; lines: 1; color: ink; measure: ttm }
        text t_body { family: Theme.face; at: tx, top + 6 + 18 + 7; anchor: left center; size: 10; width: 270; tight: true; lines: 1; color: subink; measure: tbm }
    }
    on enter toast_hit { toast_hover = true }
    on leave toast_hit { toast_hover = false; toast_n = toast_n + 1 }
    on press toast_hit { emit note_open(-1); toast = false }
    on still toast_n for 3400ms while not toast_hover { toast = false }

    // ---------- the three newest, under the open pill ----------
    let ly = top + ph + 6
    let nshow = min(3, notes.count)
    let lh = 16 + nshow * 42 + max(0, nshow - 1) * 5
    group {
        show: list_in > 0.01
        opacity: list_in
        move: 0, (1 - list_in) * -18
        shader Theme.glowblob { at: cx - 160 - 70, ly - 70; size: 320 + 140, lh + 140; values: 70, glow_k; colors: glow_a, glow_b; show: glow_k > 0 }   // midnight's glow
        body {
            color: panel
            glass: 100% * glassy
            lens: false
            tint: 72%
            border: 1 * line, mix(edge, accent, 0.4)
            shadow: sh_x, 10 * sh_k + sh_hard, 24 * sh_k + sh_min, min(1, 30% * sh_a), sh_color
            box { from: cx - 160, ly; size: 320, lh; corner: (16) * rk }
        }
        shader Theme.aurora { at: cx - 160, ly; size: 320, lh; corner: (16) * rk; values: aur_k; colors: glow_a, glow_b; show: aur_k > 0 }   // midnight's aurora
        column {
            at: cx - 152, ly + 8
            gap: 5
            for nt in notes {
                group {
                    show: nt.index < 3
                    size: 304, 42
                    zone box card { from: 0, 0; size: 304, 42; corner: (10) * rk; cursor: pointer; label: "{nt.title}" }
                    box { from: 0, 0; size: 304, 42; corner: (10) * rk; color: hover; opacity: 50% }
                    box { from: 0, 0; size: 304, 42; corner: (10) * rk; stroke: (1) * line; color: edge }
                    image ic_bell { at: 9, 14.5; size: 13, 13; tint: subink }
                    text nt.title { family: Theme.face; at: 29, 14; anchor: left center; size: 11; weight: 600; width: 245; lines: 1; color: ink }
                    text nt.body { family: Theme.face; at: 29, 29; anchor: left center; size: 10; width: 245; lines: 1; color: subink }
                    on press card { emit note_open(nt.index) }
                    // dismiss (after the card, so it wins its corner)
                    zone box nx { at: 287, 21; size: 24, 24; corner: (12) * rk; cursor: pointer; label: "Dismiss {nt.title}" }
                    image ic_x { at: 281, 15; size: 12, 12; tint: subink }
                    on press nx { emit note_close(nt.index) }
                }
            }
        }
    }
    on change toast_n while toast { flare: 1 }

    image ico_vol = icon "audio-volume-high-symbolic", 17, 17
    image ico_mute = icon "audio-volume-muted-symbolic", 17, 17
    image ico_sun = icon "display-brightness-symbolic", 17, 17

    // ---- rules ----
    every 1500ms while not ready { ready = true }

    on change vol.volume while ready { osd = volume; osd_n = osd_n + 1; flare: 1; impulse kick 9 }
    on change vol.muted while ready { osd = volume; osd_n = osd_n + 1; flare: 1; impulse kick 9 }
    on change lit.level while ready { osd = brightness; osd_n = osd_n + 1; flare: 1; impulse kick 9 }
    on still osd_n for 1600ms { osd = none }

    on change expanded while expanded { flare: 1 }
    on still flare for 300ms while flare > 0.5 { flare: 0 }

    // safety: never stay stuck open if the Alt release is missed
    on still expanded for 6s while expanded { expanded = false }

    on scroll pill { emit nudge(wheel) }

    // ======================= the control center (Super+C) =======================
    // pastel-bar's two drawers: the control center slides in from the right,
    // the music player from the left. Click outside or Esc to close.
    //   pleamar --say pastel "emit cc_toggle"
    fact cc_open = false
    fact dnd = false                       // Do Not Disturb: no toasts
    fact bt_on = false                     // (the logic fills these)
    fact bt_n = 0
    fact elapsed = 0                       // seconds into the song
    text cc_here = ""
    text out_name = ""
    text wifi_sub = ""
    text bt_sub = ""
    text dnd_sub = "Off"
    fact has_media = false                 // a music player (browsers are left out)
    fact m_playing = false
    fact m_len = 0
    fact m_seek = false
    text m_title = ""
    text m_artist = ""
    text m_art = ""                        // the cover, as a file
    repeat k in 0..2 {                     // the cover's two main colours, for its glow
        fact art_r.$k = 0.43
        fact art_g.$k = 0.65
        fact art_b.$k = 1
    }
    event cc_toggle ->
    event wifi_flip ->
    event bt_flip ->
    event mute_flip ->
    event set_vol ->
    event set_lit ->
    event seek_to ->
    event media_prev ->
    event media_play ->
    event media_next ->
    event open_settings ->                 // a page number, or -1 for just the window
    prop cc_in = 0 ~spring(220, 19)        // ≈ OutBack(1.1): a gentle overshoot
    // the music's motion: a beat on the cover, three equalizer bars, a ripple
    prop beat = 0 ~spring(260, 9)
    prop ring = 1 ~1100ms
    prop play_hot = 0 ~spring(400, 22)
    prop play_pr = 0 ~spring(600, 26)
    // what the music sounds like, from beat.py while the drawer is open and it
    // plays: bass, mids and highs (0..1), and a beat on each sudden bass hit
    fact bass = 0
    fact mid = 0
    fact high = 0
    event beat_hit
    prop bassp = 0 ~spring(700, 40)                 // quick, no wobble
    follow bassp = bass
    repeat k in 0..3 {
        prop eq.$k = 0 ~spring(600, 34)
        follow eq.$k = pick(k, bass, mid, high) * 10
    }
    on beat_hit { impulse beat 0.7; ring: 0 ~0ms; ring: 1 after 16ms }
    follow cc_in = if(cc_open, 1, 0)
    image ic_gear = icon "emblem-system-symbolic", 18, 18
    image ic_close = icon "window-close-symbolic", 16, 16
    image ic_wifi = icon "network-wireless-symbolic", 20, 20
    image ic_wifi_off = icon "network-wireless-disabled-symbolic", 20, 20
    image ic_bt = icon "bluetooth-active-symbolic", 20, 20
    image ic_bt_off = icon "bluetooth-disabled-symbolic", 20, 20
    image ic_moon = icon "weather-clear-night-symbolic", 20, 20
    image ic_sun2 = icon "display-brightness-symbolic", 16, 16
    image ic_spk = icon "audio-volume-high-symbolic", 16, 16
    image ic_spk_mute = icon "audio-volume-muted-symbolic", 20, 20
    image ic_prev = icon "media-skip-backward-symbolic", 18, 18
    image ic_next = icon "media-skip-forward-symbolic", 18, 18
    image ic_play = icon "media-playback-start-symbolic", 22, 22
    image ic_pause = icon "media-playback-pause-symbolic", 22, 22
    image ic_music = icon "folder-music-symbolic", 48, 48
    image cover = from m_art, 0, 0
    let art0 = mix(accent, rgb(art_r.0, art_g.0, art_b.0), glow_k)
    let art1 = mix(accent_lo, rgb(art_r.1, art_g.1, art_b.1), glow_k)

    // a slider, 0..1 (pastel-bar's: a label and value above the track)
    component CcSlider(label: text, value: number, moved: event, icon: image, tone: color = accent) {
        size: 340, 44
        prop v = 0 ~spring(400, 30)
        follow v = clamp(value, 0, 1)
        image icon { at: 0, 2; size: 16, 16; tint: subink }
        text label { family: Theme.face; at: 24, 10; anchor: left center; size: 12; weight: 600; color: ink }
        text "{round(value * 100)}%" { at: 340, 10; anchor: right center; size: 11; color: subink; family: Theme.mono }
        zone box hit { from: 0, 22; size: 340, 22; cursor: pointer; label: label; role: slider }
        box { from: 0, 30; size: 340, 6; corner: (3) * rk; color: subink; opacity: 30% }
        body { gradient: 0, 0 to 340, 0, accent_lo, tone
            box { from: 0, 30; size: max(6, 340 * v), 6; corner: (3) * rk } }
        body { color: tone; border: 2 * line, knob
            ellipse { at: max(6, 340 * v) - 3, 33; radius: 7 } }
        on press hit { emit moved(clamp(local.x / 340, 0, 1)) }
        on drag hit { emit moved(clamp(local.x / 340, 0, 1)) }
    }

    // a quick toggle tile: accent when on; right-click opens its settings page
    component Tile(label: text, sub: text, on: number, icon: image, icon_off: image, flip: event, more: event, page: number, tone: color = accent, reveal: number = 1) {
        size: 165, 58
        prop k = 0 ~quick
        prop hot = 0 ~spring(400, 22)
        prop pr = 0 ~spring(600, 26)
        follow k = on
        zone box hit { from: 0, 0; size: 165, 58; corner: (12) * rk; cursor: pointer; label: label; role: toggle }
        group {
            pivot: 82.5, 29
            scale: (0.82 + 0.18 * reveal) * (1 + 0.035 * hot - 0.06 * pr)
            opacity: reveal
            box { from: 0, 0; size: 165, 58; corner: (12) * rk; color: mix(hover, tone, k); opacity: 50% + 42% * k }
            box { from: 0, 0; size: 165, 58; corner: (12) * rk; stroke: (1) * line; color: edge; opacity: 1 - k }
            image icon { at: 12, 19; size: 20, 20; tint: mix(ink, onacc, k); show: on }
            image icon_off { at: 12, 19; size: 20, 20; tint: ink; show: not on }
            text label { family: Theme.face; at: 42, 21; anchor: left center; size: 13; weight: 600; color: mix(ink, onacc, k) }
            text sub { family: Theme.face; at: 42, 38; anchor: left center; size: 10; width: 115; lines: 1; color: mix(subink, onacc, k); opacity: 85% + 15% * (1 - k) }
        }
        on enter hit { hot: 1 }
        on leave hit { hot: 0; pr: 0 }
        on press hit { pr: 1; emit flip }
        on release hit { pr: 0 }
        on press right hit { emit more(page) }
    }

    surface cc {
        size: full, full
        anchor: top
        level: overlay
        screens: cc_here
        keyboard: on_demand while cc_open
        open: cc_in > 0.01

        let W = cc.width
        let H = cc.height
        let ty = 44                            // below where the pill sits

        // a click anywhere else closes it
        zone box cc_out { from: 0, 0; size: W, H; label: "Close control center" }
        on press cc_out { cc_open = false }
        on key Escape while cc_open { cc_open = false }

        // ---------------- right: the control center ----------------
        let rx = W - 14 - 380
        let rh = min(H - ty - 24, 20 + 30 + 14 + 126 + 14 + if(lit.present, 102, 50) + 14 + 30 + max(60, min(notes.count, 5) * 68) + 14)
        group {
            opacity: clamp(cc_in * 2.5, 0, 1)
            move: if(cc_in > 0.995, 0, (1 - cc_in) * 420), 0
            zone box cc_sheet { from: rx, ty; size: 380, rh; corner: (22) * rk }
            shader Theme.glowblob { at: rx - 70, ty - 70; size: 380 + 140, rh + 140; values: 70, glow_k; colors: glow_a, glow_b; show: glow_k > 0 }   // midnight's glow
            body {
                color: panel
                glass: 100% * glassy
                lens: false
                tint: 78%
                border: 1 * line, mix(edge, accent, 0.35)
                shadow: sh_x, 18 * sh_k + sh_hard, 44 * sh_k + sh_min, min(1, 40% * sh_a), sh_color
                box { from: rx, ty; size: 380, rh; corner: (22) * rk }
            }
            shader Theme.aurora { at: rx, ty; size: 380, rh; corner: (22) * rk; values: aur_k; colors: glow_a, glow_b; show: aur_k > 0 }   // midnight's aurora
            let ix = rx + 20
            let iy = ty + 20

            // header
            text "Control Center" { family: Theme.face; at: ix, iy + 12; anchor: left center; size: 17; weight: 700; color: ink }
            zone box gear { at: ix + 340 - 44, iy + 12; size: 30, 30; corner: (15) * rk; cursor: pointer; label: "Settings" }
            image ic_gear { at: ix + 340 - 53, iy + 3; size: 18, 18; tint: subink }
            zone box cc_x { at: ix + 340 - 9, iy + 12; size: 30, 30; corner: (15) * rk; cursor: pointer; label: "Close" }
            image ic_close { at: ix + 340 - 17, iy + 4; size: 16, 16; tint: subink }
            on press gear { emit open_settings(-1) }
            on press cc_x { cc_open = false }

            // quick toggles
            group {
                move: (1 - smooth(0.1, 0.6, cc_in)) * 48, 0
                grid {
                    at: ix, iy + 44
                    columns: 2
                    gap: 10
                    width: 340
                    row: 58
                    Tile("Wi-Fi", wifi_sub, net.wifi, ic_wifi, ic_wifi_off, wifi_flip, open_settings, 1, tone: col_blue, reveal: smooth(0.12, 0.50, cc_in))
                    Tile("Bluetooth", bt_sub, bt_on, ic_bt, ic_bt_off, bt_flip, open_settings, 3, tone: col_pink, reveal: smooth(0.19, 0.57, cc_in))
                    Tile("Audio", out_name, not vol.muted, ic_spk, ic_spk_mute, mute_flip, open_settings, 2, tone: col_green, reveal: smooth(0.26, 0.64, cc_in))
                    Tile("DND", dnd_sub, dnd, ic_moon, ic_moon, dnd_flip, open_settings, -2, tone: col_yellow, reveal: smooth(0.33, 0.71, cc_in))
                }
            }

            // sliders
            group {
                opacity: smooth(0.2, 0.7, cc_in)
                move: (1 - smooth(0.2, 0.7, cc_in)) * 48, 0
                column {
                    at: ix, iy + 44 + 126 + 14
                    gap: 14
                    CcSlider("Volume", if(vol.muted, 0, vol.volume), set_vol, ic_spk, tone: col_green)
                    group { show: lit.present; size: 340, 44
                        CcSlider("Brightness", lit.level, set_lit, ic_sun2, tone: col_yellow) }
                }
            }

            // notifications
            let ny = iy + 44 + 126 + 14 + if(lit.present, 102, 44) + 14
            group {
                opacity: smooth(0.3, 0.8, cc_in)
                move: (1 - smooth(0.3, 0.8, cc_in)) * 48, 0
                text "Notifications" { family: Theme.face; at: ix, ny + 10; anchor: left center; size: 13; weight: 700; color: ink }
                zone box clear_all { from: ix + 340 - 70, ny - 2; size: 70, 24; corner: (12) * rk; cursor: pointer; show: notes.count > 0 }
                box { from: ix + 340 - 70, ny - 2; size: 70, 24; corner: (12) * rk; color: hover; opacity: 80%; show: notes.count > 0 }
                text "Clear all" { family: Theme.face; at: ix + 340 - 35, ny + 10; anchor: center; size: 11; color: ink; show: notes.count > 0 }
                on press clear_all { emit clear_notes }
                text "No notifications" { family: Theme.face; at: ix + 170, ny + 50; anchor: center; size: 12; color: subink; show: notes.count == 0 }
                column {
                    at: ix, ny + 30
                    view: 340, max(10, ty + rh - 14 - (ny + 30))
                    gap: 6
                    step: 68
                    for cn in notes {
                        group {
                            size: 340, 62
                            opacity: smooth(0.35 + cn.index * 0.06, 0.8 + cn.index * 0.06, cc_in)
                            move: (1 - smooth(0.35 + cn.index * 0.06, 0.8 + cn.index * 0.06, cc_in)) * 36, 0
                            zone box ncard { from: 0, 0; size: 340, 62; corner: (10) * rk; cursor: pointer; label: "{cn.title}" }
                            box { from: 0, 0; size: 340, 62; corner: (10) * rk; color: hover; opacity: 42% }
                            box { from: 0, 0; size: 340, 62; corner: (10) * rk; stroke: (1) * line; color: edge }
                            box { from: 0, 8; size: 2, 46; corner: (1) * rk; color: accent; opacity: 80% }
                            text cn.app { family: Theme.face; at: 12, 13; anchor: left center; size: 9.5; weight: 700; width: 290; lines: 1; color: accent }
                            text cn.title { family: Theme.face; at: 12, 29; anchor: left center; size: 12; weight: 600; width: 290; lines: 1; color: ink }
                            text cn.body { family: Theme.face; at: 12, 46; anchor: left center; size: 10.5; width: 300; lines: 1; color: subink }
                            on press ncard { emit note_open(cn.index) }
                            zone box ncx { at: 322, 16; size: 24, 24; corner: (12) * rk; cursor: pointer; label: "Dismiss {cn.title}" }
                            image ic_x { at: 316, 10; size: 12, 12; tint: subink }
                            on press ncx { emit note_close(cn.index) }
                        }
                    }
                }
            }
        }

        // ---------------- left: the music player ----------------
        let mx = 14
        let mh = 440
        let has = has_media
        group {
            opacity: clamp(cc_in * 2.5, 0, 1)
            move: if(cc_in > 0.995, 0, (1 - cc_in) * -380), 0
            zone box media_sheet { from: mx, ty; size: 340, mh; corner: (22) * rk }
            shader Theme.glowblob { at: mx - 70, ty - 70; size: 340 + 140, mh + 140; values: 70, glow_k * (0.75 + 0.5 * bassp); colors: art0, art1; show: glow_k > 0 }   // midnight's glow (the cover's colours)
            body {
                color: panel
                glass: 100% * glassy
                lens: false
                tint: 78%
                border: 1 * line, mix(edge, art0, 0.35)
                shadow: sh_x, 18 * sh_k + sh_hard, 44 * sh_k + sh_min, min(1, 40% * sh_a), sh_color
                box { from: mx, ty; size: 340, mh; corner: (22) * rk }
            }
            shader Theme.aurora { at: mx, ty; size: 340, mh; corner: (22) * rk; values: aur_k; colors: art0, art1; show: aur_k > 0 }   // midnight's aurora
            // "Now Playing" tab, with a little equalizer while it plays
            box { at: mx + 170, ty + 26; size: 116, 22; corner: (11) * rk; color: art0; opacity: 18% }
            repeat k in 0..3 {
                box { at: mx + 236 + k * 5, ty + 32 - (3 + min(10, abs(eq.$k))) / 2; size: 3, 3 + min(10, abs(eq.$k)); corner: (1.5) * rk; color: art0; opacity: if(m_playing, 90%, 35%) }
            }
            text if(has, "Now Playing", "Nothing Playing") { family: Theme.face; at: mx + 170, ty + 26; anchor: center; size: 10; weight: 600; color: art0 }

            // the cover (or a gradient with a note when there is none)
            group {
                opacity: smooth(0.1, 0.6, cc_in)
                pivot: mx + 170, ty + 144
                scale: (0.9 + 0.1 * smooth(0.1, 0.7, cc_in)) * (1 + beat + 0.03 * bassp)
                body { gradient: mx + 76, ty + 50 to mx + 264, ty + 238, art0, #3f6b58
                    box { from: mx + 76, ty + 50; size: 188, 188; corner: (16) * rk } }
                image ic_music { at: mx + 146, ty + 120; size: 48, 48; tint: onacc; opacity: 60% }
                group {
                    clip box { from: mx + 76, ty + 50; size: 188, 188; corner: (16) * rk }
                    image cover { at: mx + 76, ty + 50; size: 188, 188; fit: cover; show: has }
                }
                box { from: mx + 76, ty + 50; size: 188, 188; corner: (16) * rk; stroke: (1) * line; color: edge }
            }

            // title, artist
            text m_title { family: Theme.face; at: mx + 170, ty + 266; anchor: center; size: 19; weight: 700; width: 300; lines: 1; align: center; color: ink }
            text m_artist { family: Theme.face; at: mx + 170, ty + 290; anchor: center; size: 13; width: 300; lines: 1; align: center; color: subink }

            // seek bar + times
            let sx = mx + 20
            let sw = 300
            prop done = 0 ~120ms
            follow done = clamp(elapsed / max(m_len, 1), 0, 1)
            zone box seek { from: sx, ty + 310; size: sw, 20; cursor: if(m_seek, pointer, default); label: "Seek"; role: slider }
            box { from: sx, ty + 317; size: sw, 6; corner: (3) * rk; color: subink; opacity: 30% }
            box { from: sx, ty + 318; size: max(4, sw * done), 4; corner: (2) * rk; color: art0 }
            ellipse { at: sx + sw * done, ty + 320; radius: 6; color: art0 }
            on press seek while m_seek { emit seek_to(clamp(local.x - sx, 0, sw) / sw) }
            text "{elapsed, time}" { at: sx, ty + 342; anchor: left center; size: 10; color: subink; family: Theme.mono }
            text "{m_len, time}" { at: sx + sw, ty + 342; anchor: right center; size: 10; color: subink; family: Theme.mono }

            // transport
            zone box prev { at: mx + 100, ty + 392; size: 40, 40; corner: (20) * rk; cursor: pointer; label: "Previous" }
            box { at: mx + 100, ty + 392; size: 40, 40; corner: (20) * rk; color: hover; opacity: 80% }
            image ic_prev { at: mx + 91, ty + 383; size: 18, 18; tint: ink }
            zone box play { at: mx + 170, ty + 392; size: 52, 52; corner: (26) * rk; cursor: pointer; label: if(m_playing, "Pause", "Play") }
            // a ring ripples out of it while it plays
            ellipse { at: mx + 170, ty + 392; radius: 26 + 18 * ring; stroke: 2; color: art0; opacity: (1 - ring) * 60% * m_playing }
            group {
                pivot: mx + 170, ty + 392
                scale: 1 + 0.06 * play_hot - 0.1 * play_pr
                box { at: mx + 170, ty + 392; size: 52, 52; corner: (26) * rk; color: art0 }
                image ic_play { at: mx + 159, ty + 381; size: 22, 22; tint: onacc; show: not m_playing }
                image ic_pause { at: mx + 159, ty + 381; size: 22, 22; tint: onacc; show: m_playing }
            }
            on enter play { play_hot: 1 }
            on leave play { play_hot: 0; play_pr: 0 }
            on release play { play_pr: 0 }
            zone box next { at: mx + 240, ty + 392; size: 40, 40; corner: (20) * rk; cursor: pointer; label: "Next" }
            box { at: mx + 240, ty + 392; size: 40, 40; corner: (20) * rk; color: hover; opacity: 80% }
            image ic_next { at: mx + 231, ty + 383; size: 18, 18; tint: ink }
            on press prev while has_media { emit media_prev }
            on press play { play_pr: 1 }
            on press play while has_media { emit media_play }
            on press next while has_media { emit media_next }
        }
    }
    event dnd_flip
    on dnd_flip { toggle dnd }
}
