language 0.6
import "../../theme.plm"

// password — pastel-bar's polkit dialog (~/dotfiles/pastel-bar/overlays/PolkitDialog.qml),
// Mint dark. While this runs it is the session's polkit agent: when a program
// wants to do something as root (pkexec, mounting a disk…), the screen dims and
// a glass box asks for the password. The answer goes straight to polkit's own
// helper; it is not kept anywhere. Try it: `pkexec true`.

scene Password {
    permissions {
        services: "polkit", "polkit.*"
        run: "hyprctl monitors -j"
    }

    service polkit as auth {
        ready: bool
        pending: bool
        asking: bool
        message: text
        action: text
        user: text
        prompt: text
        info: text
        error: none | wrong
    }


    text here = ""                   // the monitor in use when it was asked
    text answer = ""
    event send ->
    event dismiss ->

    prop shown = 0 ~spring(300, 20)
    follow shown = if(auth.pending, 1, 0)

    image ic_lock = icon "changes-prevent-symbolic", 20, 20

    surface win {
        size: full, full
        anchor: top
        level: overlay
        screens: here
        keyboard: exclusive while auth.pending
        open: shown > 0.01

        let W = win.width
        let H = win.height
        let pw = 440
        let ph = 262
        let px = W / 2 - pw / 2
        let py = H / 2 - ph / 2

        // dim (and, being dark enough, frost) the whole screen
        box { from: 0, 0; size: W, H; color: #000000; opacity: 40% * shown }

        group {
            pivot: W / 2, H / 2
            scale: 0.88 + 0.12 * shown
            opacity: clamp(shown * 1.5, 0, 1)

            shader Theme.glowblob { at: px - 70, py - 70; size: pw + 140, ph + 140; values: 70, glow_k; colors: glow_a, glow_b; show: glow_k > 0 }   // midnight's glow

            body {
                color: panel
                glass: 100% * glassy
                lens: false
                tint: 80%
                border: 1 * line, mix(edge, col_pink, 0.5)
                shadow: sh_x, 18 * sh_k + sh_hard, 44 * sh_k + sh_min, min(1, 40% * sh_a), sh_color
                box { from: px, py; size: pw, ph; corner: (16) * rk }
            }
            shader Theme.aurora { at: px, py; size: pw, ph; corner: (16) * rk; values: aur_k; colors: glow_a, glow_b; show: aur_k > 0 }   // midnight's aurora

            image ic_lock { at: px + 18, py + 20; size: 20, 20; tint: col_pink }
            text "Authentication Required" { family: Theme.face; at: px + 48, py + 30; anchor: left center; size: 16; weight: 700; color: ink }
            text auth.message { family: Theme.face; at: px + 18, py + 56; width: pw - 36; lines: 2; size: 13; color: subink }
            text auth.action { family: Theme.face; at: px + 18, py + 98; anchor: left center; width: pw - 36; lines: 1; size: 10; color: subink; opacity: 70% }

            // the field
            box { from: px + 18, py + 114; size: pw - 36, 38; corner: (10) * rk; color: field; opacity: 80% }
            box { from: px + 18, py + 114; size: pw - 36, 38; corner: (10) * rk; stroke: (1) * line; color: if(auth.asking, col_pink, edge); opacity: if(auth.asking, 70%, 100%) }
            text "{auth.prompt}" { family: Theme.face; at: px + 30, py + 133; anchor: left center; size: 14; color: subink; show: not typed }
            text "for {auth.user}" { family: Theme.face; at: px + pw - 30, py + 133; anchor: right center; size: 11; color: col_pink; show: not typed }
            // Whoever sits there types it: an agent at the desktop is not let into this field.
            input answer { family: Theme.face; at: px + 30, py + 124; width: pw - 60; size: 14; color: ink; secret: true; agent: no; label: "Password" }

            // what the system says, or that it was wrong
            text auth.info { family: Theme.face; at: px + 18, py + 172; anchor: left center; width: pw - 36; lines: 1; size: 11; color: subink; show: auth.error == none }
            text "That was not it. Try again." { family: Theme.face; at: px + 18, py + 172; anchor: left center; size: 11; color: danger; show: auth.error == wrong }
            text "Checking…" { family: Theme.face; at: px + 18, py + 172; anchor: left center; size: 11; color: subink; show: auth.pending and not auth.asking and auth.error == none }

            // buttons
            zone box cancel { from: px + pw - 18 - 118 - 10 - 92, py + ph - 52; size: 92, 34; corner: (9) * rk; cursor: pointer; label: "Cancel" }
            box { from: px + pw - 18 - 118 - 10 - 92, py + ph - 52; size: 92, 34; corner: (9) * rk; color: hover }
            box { from: px + pw - 18 - 118 - 10 - 92, py + ph - 52; size: 92, 34; corner: (9) * rk; stroke: (1) * line; color: edge }
            text "Cancel" { family: Theme.face; at: px + pw - 18 - 118 - 10 - 46, py + ph - 35; anchor: center; size: 12; color: ink }
            // Letting a program through is for whoever sits there to do, not for an agent.
            zone box ok { from: px + pw - 18 - 118, py + ph - 52; size: 118, 34; corner: (9) * rk; cursor: pointer; label: "Authenticate"; agent: no }
            box { from: px + pw - 18 - 118, py + ph - 52; size: 118, 34; corner: (9) * rk; color: col_pink; opacity: 92% }
            text "Authenticate" { family: Theme.face; at: px + pw - 18 - 59, py + ph - 35; anchor: center; size: 12; weight: 600; color: onacc }
        }

        on change auth.pending { focus answer }
        on change auth.asking  { focus answer }
        on submit answer       { emit send }
        on press ok            { emit send }
        on press cancel        { emit dismiss }
        on key Escape while auth.pending { emit dismiss }
    }

    fact typed = false
}
