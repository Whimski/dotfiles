// Midnight — dark and smooth: near-black cards with faint borders, a bright
// colour for each thing (blue Wi-Fi, pink Bluetooth, green sound, yellow DND…),
// and soft drifting glows behind and inside the big cards (themes/glow.wgsl,
// themes/aurora.wgsl). Inter, and Geist Mono.
// Every shell imports ~/.config/pleamar/theme.plm, which is a copy of the
// theme in use; Settings → Wallpaper & Style → Style copies one of these over it.
library Theme {
    // colours
    let panel     = #161618
    let edge      = #2a2a2f
    let accent    = #8ea2ff    // periwinkle: chosen, pressed, filled
    let accent_lo = #b18cff    // gradients go violet → periwinkle
    let onacc     = #0f0f14    // text on a bright colour
    let ink       = #ececef
    let subink    = #8b8b93
    let danger    = #ff6b81
    let hover     = #222226
    let ground    = #0c0c0d
    let field     = #1c1c1f
    let knob      = #111113

    // colours for things of their own (each page, each tile)
    let col_blue   = #6ea8ff
    let col_pink   = #ff7eb6
    let col_green  = #5ee8a0
    let col_yellow = #ffd166
    let col_violet = #b18cff

    // shape
    let rk      = 1
    let glassy  = 0        // solid cards
    let line    = 1
    let sh_x    = 0
    let sh_k    = 1
    let sh_color = #000000
    let sh_a    = 1.4
    let sh_min  = 0
    let sh_hard = 0


    // glows behind cards (themes/glow.wgsl)
    shader glowblob = file "themes/glow.wgsl"
    let glow_k    = 1
    let glow_a    = #ff7eb3    // pink, top right
    let glow_b    = #6ea8ff    // blue, bottom left

    // a soft light drifting inside the big cards (themes/aurora.wgsl)
    shader aurora = file "themes/aurora.wgsl"
    let aur_k     = 1        // how strong (0: none)

    // type
    text face = "Inter"
    text mono = "GeistMono Nerd Font Mono"
}
